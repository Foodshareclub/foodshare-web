{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "warn"
      },
      "a11y": {
        "useSemanticElements": "off"
      },
      "complexity": {
        "noForEach": "off",
        "noStaticOnlyClass": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "files": {
    "ignore": [
      ".next/**",
      "out/**",
      "node_modules/**",
      "coverage/**",
      "public/**",
      "supabase/**",
      "src/wasm/**",
      "e2e/__tmp/**",
      ".check-classes-*/**",
      ".check-adornments-*/**",
      ".check-i18n-text-*/**",
      "test-results/**"
    ]
  },
  "overrides": [
    {
      "include": ["src/__tests__/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noThenProperty": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
