# foodshare-web Quadlet unit (Podman/systemd) — CANONICAL SOURCE OF TRUTH.
# Deploy: `bun run quadlet:install` copies this + the .network unit to
# ~/.config/containers/systemd/ and starts it via systemctl --user.
# Mirrored to .github/quadlet/ for CI visibility — do not edit the copies.
[Unit]
Description=FoodShare Web (Next.js standalone)
After=network-online.target foodshare-web-network.service
Wants=network-online.target
Requires=foodshare-web-network.service

[Container]
Image=ghcr.io/foodshareclub/foodshare-web:latest
ContainerName=foodshare-web
PublishPort=3000:3000
Network=foodshare-web.network
EnvironmentFile=/etc/foodshare/foodshare-web.env
User=nextjs
Memory=1G
PidsLimit=100
ReadOnly=true
Tmpfs=/tmp
Tmpfs=/app/.next/cache
NoNewPrivileges=true
DropCapability=ALL
HealthCmd=curl -f http://localhost:3000/api/health || exit 1
HealthInterval=20s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=60s
Label=autoheal=true

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
