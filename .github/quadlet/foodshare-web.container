# foodshare-web Quadlet unit (Podman/systemd) — CANONICAL SOURCE OF TRUTH.
# Deploy: `bun run quadlet:install` copies this + the .network unit to
# ~/.config/containers/systemd/ and starts it via systemctl --user.
# Mirrored to .github/quadlet/ for CI visibility — do not edit the copies.
[Unit]
Description=FoodShare Web (Next.js standalone)
After=network-online.target foodshare-web-network.service
Wants=network-online.target
Requires=foodshare-web-network.service

[Container]
Image=ghcr.io/foodshareclub/foodshare-web:latest
ContainerName=foodshare-web
# Loopback only. `3000:3000` binds 0.0.0.0, which made the origin reachable
# from the internet with no Cloudflare in front — so the forwarded-IP headers
# src/proxy.ts keys every rate limit and ban on were attacker-controlled, and
# Cloudflare's protections could be bypassed entirely. cloudflared runs in the
# same podman network and never needed a host port; this one exists only for
# `curl http://localhost:3000/api/health` in HealthCmd and for local debugging.
PublishPort=127.0.0.1:3000:3000
Network=foodshare-web.network
EnvironmentFile=/etc/foodshare/foodshare-web.env
User=nextjs
Memory=1G
# The floor the service is guaranteed, and the ceiling it may not pass. The
# ceiling was `deploy.resources.limits.memory` before; the floor was
# `deploy.resources.reservations.memory`, and it is the one that keeps the
# service alive under pressure rather than the one that kills it.
MemoryMin=256M
PidsLimit=100
ReadOnly=true
Tmpfs=/tmp
Tmpfs=/app/.next/cache
NoNewPrivileges=true
DropCapability=ALL
# The file-descriptor ceiling the service was given, so it is given here.
# Node opens a file per socket and per log stream, and the default limit is
# low enough to be reached by a busy day.
Ulimit=nofile=65536:65536
# Bounded container logs, as before: 10 MB per file, three files, 30 MB in
# total. The default is the journal, and the journal's own bound is a host
# setting this repository cannot state — so the bound the service was given
# is stated here, where it is visible.
LogDriver=json-file
LogOpt=max-size=10m
LogOpt=max-file=3
# /api/ready, not /api/health. /api/health probes PostgREST, GoTrue, storage and
# Upstash — four round trips every 20 seconds, and one slow Upstash reply
# (the route allows 3s) marks the container unhealthy, so autoheal restarts the
# whole app. /api/ready is a constant and is prerendered. The deep probe still
# exists at /api/health for monitoring to scrape on a slower cadence.
HealthCmd=curl -fsS http://localhost:3000/api/ready || exit 1
HealthInterval=20s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=60s
Label=autoheal=true

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
