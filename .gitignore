# dependencies
/node_modules
.bun-build
package-lock.json
yarn.lock

# testing
/coverage
/test-results
/playwright-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# env files (can opt-in for committing if needed)
.env*
!.env.production.example

