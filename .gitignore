# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
.bun-build
package-lock.json
yarn.lock

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
# AppleDouble resource forks (macOS writes these beside every file it
# touches on non-HFS volumes; they are noise, never content).
._*
*.pem

# env files (can opt-in for committing if needed)
.env*
!.env.production.example
# Sentry env files are committable by design: DSN/org/project are public
# client identifiers; SENTRY_AUTH_TOKEN (secret) is never stored in them.
!.env.production.sentry
!.env.example.sentry

# typescript
*.tsbuildinfo
next-env.d.ts

# Rust build artifacts
tools/target/

# Local scratch space for one-off e2e spec experiments
e2e/__tmp/

# Supabase local config (keep migrations/functions tracked)
/supabase/*
!/supabase/config.toml
!/supabase/seed.sql
!/supabase/migrations/
!/supabase/functions/
supabase/functions/node_modules/
supabase/.temp
.env*.local

# Build logs and temp files
*.log
api-usage-audit.json
.vercel
downloaded-artifact/

logs/

# Fixtures created by src/__tests__/lib/class-check.test.ts
.check-classes-*/
.check-adornments-*/
.check-i18n-text-*/
