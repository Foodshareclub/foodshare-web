[Unit]
Description=Foodshare Next.js frontend
After=foodshare-network.service
Requires=foodshare-network.service
BindsTo=foodshare-network.service

[Container]
Tmpfs=/app/.next/cache:rw,size=256m,mode=1777,nosuid,nodev,noexec
Tmpfs=/app/.next/server/route-cache:rw,size=128m,mode=1777,nosuid,nodev,noexec
# Pinned by tag on purpose: CI builds and pushes :latest per commit.
# For digest-pinned deploys, replace with Image=ghcr.io/foodshareclub/foodshare-web@sha256:<digest>.
# No AutoUpdate=registry here by design — deploys are deliberate via CI (see cd.yml),
# never timer-driven surprises.
Image=ghcr.io/foodshareclub/foodshare-web:latest
ContainerName=foodshare-web
Network=foodshare.network
PublishPort=127.0.0.1:3000:3000
EnvironmentFile=%h/.config/foodshare/web.env
# Probe /api/ready, not /: the probe curls the app every interval, and /
# passes the global rate limiter in src/proxy.ts — two Upstash REST calls
# per probe (the limit script plus the analytics record). At the 15 s
# cadence the probe alone burned ~345,000 of the 500,000-request monthly
# quota with zero users behind it (2026-11-16). /api/ready is exempt from
# the limiter, constant and prerendered — the probe pays zero Upstash
# calls. The deep probe stays at /api/health for a slower monitoring
# cadence. The parameters match the canonical unit at the repository root.
HealthCmd=curl -fsS http://localhost:3000/api/ready || exit 1
HealthInterval=20s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=60s
Notify=healthy

ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
UserNS=keep-id

[Service]
Restart=always
TimeoutStartSec=120
Type=notify

[Install]
WantedBy=default.target
