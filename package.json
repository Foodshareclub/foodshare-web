    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "5.2.11",
    "react-hook-form": "7.86.0",
    "react-leaflet": "5.0.0",
    "react-leaflet-cluster": "4.1.3",
    "recharts": "3.10.1",
    "resend": "6.18.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
