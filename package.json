{
  "name": "foodshare",
  "version": "3.0.2",
  "private": true,
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "build": "bun --bun next build --turbopack",
    "build:analyze": "bun --bun next build --turbopack --experimental-analyze",
    "dev": "bun --bun next dev --turbopack -p 3000",
    "start": "bun --bun next start",
    "build:args": "bun scripts/check-build-args.ts",
    "check:build-network": "bun scripts/check-build-network.ts",
    "check:catalogue": "bun scripts/check-catalogue.ts",
    "check:i18n-attributes": "bun scripts/check-i18n-attributes.ts",
    "check:namespace-keys": "bun scripts/check-namespace-keys.ts",
    "check:locale-coverage": "bun scripts/check-locale-coverage.ts",
    "check:no-node": "bun scripts/check-no-node.ts",
    "check:tsconfig-shape": "bun scripts/check-tsconfig-shape.ts",
    "check:yaml": "bun scripts/check-yaml.ts",
    "build:check": "bun run build && bun scripts/check-bundle-size.ts",
    "check:adornments": "bun scripts/check-adornments.ts",
    "check:classes": "bun scripts/check-classes.ts",
    "check:contrast": "bun scripts/check-contrast.ts",
    "check:i18n-text": "bun scripts/check-i18n-text.ts",
    "check:rtl": "bun scripts/check-rtl.ts",
    "clean": "rm -rf .next out node_modules/.cache .turbo",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f foodshare-web",
    "docker:up": "docker compose up -d",
    "e2e": "bun run playwright test",
    "e2e:debug": "bun run playwright test --debug",
    "e2e:headed": "bun run playwright test --headed",
    "e2e:report": "bun run playwright show-report",
    "e2e:ui": "bun run playwright test --ui",
    "email:dev": "bun run email dev -p 3001 --dir src/emails",
    "email:export": "bun run email export --outDir src/emails/templates/exported",
    "format:biome": "bun run biome format --write .",
    "gpu:check": "bun scripts/check-gpu-backgrounds.ts",
    "gpu:doctor": "bun run vgpu doctor",
    "import:foodbanks": "bun run scripts/foodbank-import/index.ts",
    "lint": "bun run --parallel lint:oxlint check:rtl",
    "lint:biome": "bun scripts/check-changed-format.ts",
    "lint:fix": "bun run oxlint --fix && bun run biome check --write .",
    "lint:oxlint": "bun run oxlint",
    "podman:build": "podman build -t ghcr.io/foodshareclub/foodshare-web:latest .",
    "podman:down": "podman compose down || podman-compose down",
    "podman:logs": "podman logs -f foodshare-web",
    "podman:up": "podman compose up -d || podman-compose up -d",
    "quadlet:install": "bash scripts/quadlet-install.sh",
    "sweep:rtl": "bun scripts/sweep-rtl.ts",
    "sync:types": "../foodshare-backend/scripts/sync-types.sh",
    "test": "bun test --isolate src/",
    "test:build": "bun run check:no-node && bun run check:tsconfig-shape && bun run type-check && bun run lint && bun run build && bun run --parallel check:catalogue check:locale-coverage check:i18n-text check:i18n-attributes check:namespace-keys translations:check",
    "test:ci": "bun test --ci --isolate --coverage src/",
    "test:coverage": "bun test --isolate --coverage --coverage-reporter=text --coverage-reporter=lcov src/",
    "test:order": "bun test --ci --isolate --randomize src/",
    "test:watch": "bun test --isolate --watch src/",
    "translations:check": "bun scripts/check-translations.ts",
    "translations:sync": "bun scripts/sync-translations.ts",
    "type-check": "bun run tsrs --noEmit",
    "type-check:tsc": "bun run tsc --noEmit",
    "verify:quadlet": "bash scripts/verify-quadlet.sh",
    "verify:sentry": "bun scripts/verify-sentry.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.41",
    "@aws-sdk/client-ses": "3.1094.0",
    "@getbrevo/brevo": "3.0.4",
    "@motherduck/wasm-client": "0.8.1",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
