{
  "name": "foodshare",
  "version": "3.0.2",
  "private": true,
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun next dev --turbopack -p 3000",
    "build": "rm -rf .next && bun next build --turbopack",
    "build:analyze": "bun next build --turbopack --experimental-analyze",
    "start": "bun next start",
    "lint": "oxlint",
    "lint:eslint": "bunx eslint",
    "lint:oxlint": "oxlint",
    "lint:biome": "bunx biome check .",
    "format:biome": "bunx biome format --write .",
    "lint:fix": "oxlint --fix && bunx biome check --write . && bunx eslint --fix",
    "type-check": "bunx tsc --noEmit",
    "test": "bun test src/__tests__/actions/admin.test.ts && bun test src/__tests__/actions/auth.test.ts src/__tests__/actions/email.test.ts src/__tests__/actions/newsletter.test.ts src/__tests__/actions/products.test.ts src/__tests__/lib/ src/store/ src/utils/ src/api/ src/lib/logger/ src/lib/testing/ src/__tests__/components/ src/__tests__/api/ && bun test src/__tests__/actions/chat.test.ts && bun test src/__tests__/integration/",
    "test:watch": "bun test --watch src/",
    "test:coverage": "bun test --coverage src/__tests__/actions/admin.test.ts && bun test --coverage src/__tests__/actions/auth.test.ts src/__tests__/actions/email.test.ts src/__tests__/actions/newsletter.test.ts src/__tests__/actions/products.test.ts src/__tests__/lib/ src/store/ src/utils/ src/api/ src/lib/logger/ src/lib/testing/ src/__tests__/components/ src/__tests__/api/ && bun test --coverage src/__tests__/actions/chat.test.ts && bun test --coverage src/__tests__/integration/",
    "test:ci": "bun test --ci --coverage src/__tests__/actions/admin.test.ts && bun test --ci --coverage src/__tests__/actions/auth.test.ts src/__tests__/actions/email.test.ts src/__tests__/actions/newsletter.test.ts src/__tests__/actions/products.test.ts src/__tests__/lib/ src/store/ src/utils/ src/api/ src/lib/logger/ src/lib/testing/ src/__tests__/components/ src/__tests__/api/ && bun test --ci --coverage src/__tests__/actions/chat.test.ts && bun test --ci --coverage src/__tests__/integration/",
    "e2e": "bunx playwright test",
    "e2e:ui": "bunx playwright test --ui",
    "e2e:headed": "bunx playwright test --headed",
    "e2e:debug": "bunx playwright test --debug",
    "e2e:report": "bunx playwright show-report",
    "build:check": "bun run build && bun scripts/check-bundle-size.ts",
    "test:build": "bun run type-check && bun run lint && bun run build",
    "clean": "rm -rf .next out node_modules/.cache .turbo",
    "postinstall": "bun run patch-package",
    "sync:types": "../foodshare-backend/scripts/sync-types.sh",
    "import:foodbanks": "bun run scripts/foodbank-import/index.ts",
    "translations:sync": "bun scripts/sync-translations.ts",
    "email:dev": "bunx email dev -p 3001 --dir src/emails",
    "email:export": "bunx email export --outDir src/emails/templates/exported",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f foodshare-web"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.41",
    "@aws-sdk/client-ses": "3.1094.0",
    "@getbrevo/brevo": "3.0.4",
    "@motherduck/wasm-client": "0.8.1",
    "@radix-ui/react-avatar": "1.2.5",
    "@radix-ui/react-checkbox": "1.3.10",
