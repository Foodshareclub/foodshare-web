    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-visually-hidden": "1.2.11",
    "@react-email/components": "1.0.12",
    "@sentry/nextjs": "10.71.0",
    "@sentry/node": "10.71.0",
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "2.112.4",
    "@tanstack/react-query": "5.102.6",
    "@tanstack/react-query-devtools": "5.102.6",
    "@tinybirdco/sdk": "0.0.82",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extension-link": "3.30.5",
    "@tiptap/extension-placeholder": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@trigger.dev/sdk": "4.5.12",
    "@types/canvas-confetti": "1.9.0",
    "@upstash/qstash": "2.11.3",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.3",
    "@upstash/search": "0.1.7",
    "@upstash/vector": "1.2.3",
    "@vgpu/wgsl": "0.3.1",
    "ai": "6.0.116",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.16",
