    "@trigger.dev/sdk": "4.5.7",
    "@types/canvas-confetti": "1.9.0",
    "@upstash/qstash": "2.11.3",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.0",
    "@upstash/search": "0.1.7",
    "@upstash/vector": "1.2.3",
    "ai": "6.0.116",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.13",
    "framer-motion": "12.42.2",
    "hono": "4.13.5",
    "leaflet": "1.9.4",
    "leaflet-geosearch": "4.4.0",
    "lucide-react": "0.577.0",
    "mailersend": "2.8.0",
    "next": "16.3.3",
    "next-intl": "4.13.4",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "5.2.11",
    "react-hook-form": "7.82.0",
    "react-leaflet": "5.0.0",
    "react-leaflet-cluster": "4.1.3",
    "recharts": "3.10.0",
    "resend": "6.18.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "web-vitals": "5.3.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "overrides": {
    "qs": ">=6.14.1",
    "diff": ">=4.0.4",
