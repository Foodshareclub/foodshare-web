# =============================================================================
# FoodShare Production Environment Variables
# =============================================================================
# Copy to .env.production and fill in your values
#
# NOTE: In this new secret management architecture, you only need to provide 
# the core Supabase connection keys here. 
# 
# ALL OTHER OPERATIONAL SECRETS (Upstash, Sentry, Resend, AI keys, etc.) 
# are automatically pulled from the foodshare-backend's `.env.functions` and 
# the Supabase Vault during deployment (see `.github/workflows/ci.yml`).
# =============================================================================

# --- Supabase [REQUIRED] ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application URLs [REQUIRED] ---
NEXT_PUBLIC_APP_URL=https://foodshare.club
NEXT_PUBLIC_SITE_URL=https://foodshare.club
