{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noEmit": true,

    // Bun's ambient types: the `Bun` global, `bun:test` and the `bun:*`
    // builtin modules that `bun check` resolves natively.
    //
    // "node" is deliberately absent. The Node-compat globals this project
    // relies on (`process`, `Buffer`) are declared by `bun-types` itself, so
    // they are still in scope — but the *ambient surface* the project type-checks
    // against is Bun's, not Node's. Listing "node" here would let a stray
    // Node-only global slip into the tree without anyone noticing; a project
    // that runs on Bun should not be able to type-check against Node's API by
    // accident.
    "types": ["bun"],

    // Strict type checking
    "strict": true,
    // TODO: Enable noUncheckedIndexedAccess after fixing all array index access patterns
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,

    // Code quality
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,

    // Import/Export
    "verbatimModuleSyntax": false,

    // Next.js plugin
    "plugins": [
      {
        "name": "next"
      }
    ],

    // Path aliases
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "supabase/**",
    // Scratch space for throwaway Playwright specs. It is gitignored, and a
    // half-written spec in it used to break `next build` outright: the
    // type-check covers every `*.ts` in the tree, and nothing excluded it.
    "e2e/__tmp/**"
  ]
}
