# Sentry Environment Configuration Example
# Copy to .env.production.sentry and replace with your values

NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
# Auth token for sourcemap upload / release creation. Never commit the real value.
# Provide via CI secrets (SENTRY_AUTH_TOKEN) or a local untracked .env file.
# SENTRY_AUTH_TOKEN=sntrys_xxx
SENTRY_DEBUG=false