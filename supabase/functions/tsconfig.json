{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noImplicitAny": false,
    "paths": {
      "@shared/*": ["./_shared/*"],
      "@shared": ["./_shared/index.ts"]
    }
  },
  "include": [
    "./**/*.ts",
    "../../types/deno.d.ts",
    "../../types/std-assert.d.ts",
    "../../types/std-testing-bdd.d.ts"
  ],
  "exclude": ["node_modules"]
}
