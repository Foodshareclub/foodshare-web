{
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "nodeModulesDir": "auto",
  "exclude": ["node_modules", "vendor"],
  "lock": false,
  "imports": {
    "hono": "npm:hono@^4",
    "hono/": "npm:hono@^4/",
    "jose": "npm:jose@5.2.2",
    "zod": "npm:zod@3.22.4",
    "@sentry/deno": "npm:@sentry/deno@^8",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.43.4",
    "standardwebhooks": "npm:standardwebhooks@^1.0.0",
    "@shared/": "./_shared/",
    "@shared": "./_shared/index.ts"
  },
  "tasks": {
    "dev": "deno run --allow-all --watch",
    // --no-check because the type errors are budgeted, not absent.
    //
    // `deno task test` type-checks every test file and everything it imports,
    // so while a known set of type errors exists it fails before running a
    // single assertion — which makes CI permanently red, and a permanently red
    // check is one nobody reads. The checking is not disabled, it is moved:
    // `__tests__/typecheck-baseline.test.ts` runs `deno check` over all 414
    // TypeScript files itself and fails on any error outside
    // `typecheck-baseline.json`, and fails again on any baseline entry that has
    // stopped occurring. Both halves are stricter than what is being given up
    // here, which only ever reported "some type error somewhere".
    //
    // If you are here because types seem unchecked: they are checked, on every
    // run, and the current debt is printed by that test.
    "test": "DENO_JOBS=1 deno test --allow-all --no-check",
    "check": "deno check",
    "lint": "deno lint",
    "lint:oxlint": "oxlint",
    "lint:biome": "biome check .",
    "fmt": "deno fmt"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["require-await", "no-explicit-any"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve"
  }
}
