# =============================================================================
# Local Development Environment Variables
# =============================================================================
# Copy to .env.local and fill in your values
#
# This file shows additional optional variables for local development.
# Core Supabase variables should be in .env.example
# =============================================================================

# --- OAuth Providers [OPTIONAL] ---
# Enable OAuth providers that are configured in your Supabase project
# Set to "true" to enable, leave commented out to disable
# You must configure these providers in Supabase Dashboard first!

# NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=true
# NEXT_PUBLIC_OAUTH_FACEBOOK_ENABLED=true
# NEXT_PUBLIC_OAUTH_APPLE_ENABLED=true
# NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=true

# --- Analytics [OPTIONAL] ---
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# --- Site Verification [OPTIONAL] ---
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code
