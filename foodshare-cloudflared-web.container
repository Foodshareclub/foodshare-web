# foodshare-cloudflared-web Quadlet unit (Podman/systemd) — CANONICAL SOURCE.
# Cloudflare Tunnel exposing the local Next.js server. Token comes from the
# same EnvironmentFile as the web unit (CLOUDFLARE_TUNNEL_TOKEN or TUNNEL_TOKEN).
# Mirrored to .github/quadlet/ for CI visibility — do not edit the copies.
[Unit]
Description=FoodShare Cloudflared Tunnel
After=network-online.target foodshare-web-network.service
Wants=network-online.target
Requires=foodshare-web-network.service

[Container]
Image=docker.io/cloudflare/cloudflared:latest
ContainerName=foodshare-cloudflared-web
Network=foodshare-web.network
EnvironmentFile=/etc/foodshare/foodshare-web.env
Exec=tunnel --no-autoupdate --metrics 0.0.0.0:2000 run
HealthCmd=cloudflared --version
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5
Label=autoheal=true

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
